aws_region             = "ap-northeast-1"
project                = "basi-magic.shogi"
lambda_zip_path        = "../../dist/lambda.zip"
lambda_architecture    = "arm64"
lambda_memory_mb       = 1024
lambda_timeout_seconds = 30
log_retention_in_days  = 14
readiness_check_path   = "/api/health"

# Use a separate dev Supabase project. Do not put production credentials here.
dev_supabase_url              = "https://your-dev-project.supabase.co"
dev_supabase_service_role_key = "replace-me"

# ai_engine_base_url           = "https://your-dev-ai-engine.example.com"
# matching_bff_internal_token = "replace-with-dev-internal-token"
# matching_ticket_secret      = "replace-with-dev-ticket-secret"
